generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Auth & Users
// ============================================================

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  hashedPassword String
  avatar         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  familyId String?
  family   Family?    @relation(fields: [familyId], references: [id])
  role     FamilyRole @default(MEMBER)

  accounts       Account[]       @relation("AccountOwner")
  balanceRecords BalanceRecord[] @relation("RecordCreator")

  @@index([email])
  @@index([familyId])
}

enum FamilyRole {
  ADMIN
  MEMBER
}

// ============================================================
// Family (multi-user household)
// ============================================================

model Family {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members User[]
}

// ============================================================
// Accounts & Balance Records
// ============================================================

model Account {
  id         String      @id @default(cuid())
  name       String
  type       AccountType
  currency   String      @default("CNY")
  icon       String?
  isActive   Boolean     @default(true)
  visibility Visibility  @default(FAMILY)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  ownerId String
  owner   User   @relation("AccountOwner", fields: [ownerId], references: [id])

  balanceRecords BalanceRecord[]

  @@index([ownerId])
  @@index([ownerId, isActive])
}

enum AccountType {
  BANK
  CREDIT_CARD
  E_WALLET
  INVESTMENT
  REAL_ESTATE
  LIABILITY
  OTHER
}

enum Visibility {
  FAMILY
  PRIVATE
}

model BalanceRecord {
  id         String   @id @default(cuid())
  amount     Decimal  @db.Decimal(15, 2)
  note       String?
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  accountId    String
  account      Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recordedById String
  recordedBy   User    @relation("RecordCreator", fields: [recordedById], references: [id])

  @@index([accountId])
  @@index([accountId, recordedAt])
  @@index([recordedAt])
}
